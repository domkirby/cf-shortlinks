{
  "name": "domk-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-native link shortener you deploy to your own domain",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r --if-present lint",
    "dev:redirect": "pnpm --filter @domk/redirect-worker dev",
    "dev:api": "pnpm --filter @domk/admin-api dev",
    "dev:frontend": "pnpm --filter @domk/admin-frontend dev",
    "dev:interactive": "pnpm --filter @domk/interactive-link dev",
    "db:generate": "pnpm --filter @domk/db-schema generate",
    "db:migrate:local": "pnpm --filter @domk/db-schema migrate:local",
    "db:migrate:remote": "pnpm --filter @domk/db-schema migrate:remote"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@cloudflare/workerd-linux-64"
    ]
  }
}
