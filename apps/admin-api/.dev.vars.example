# Copy to .dev.vars for `wrangler dev`. Never commit the real file.
#
# There is no Access proxy in front of a local dev server, so there is no JWT
# to verify. DEV_BYPASS_AUTH assumes an owner identity instead — it only takes
# effect on a loopback hostname, so leaving it set can't authenticate a real
# request to your admin hostname in production.
DEV_BYPASS_AUTH=1
DEV_ACTOR_EMAIL=you@example.com

# Needed only for the /api/stats routes; they hit the real Analytics Engine
# SQL API even in local dev.
CF_ANALYTICS_API_TOKEN=
