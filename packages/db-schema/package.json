{
  "name": "@domk/db-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./migrations"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply DB --local --config ../../apps/admin-api/wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config ../../apps/admin-api/wrangler.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.123.0"
  }
}
